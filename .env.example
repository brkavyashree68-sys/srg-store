SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///srg.db
FLASK_DEBUG=1
# Gmail SMTP: enable 2-Step Verification on the sender Google account and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-srg-sender@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-srg-sender@gmail.com
# Single admin login identity
ADMIN_EMAIL=admin@example.com
# Comma-separated retail delivery slabs in ascending min subtotal order, e.g. 0:60,500:30,1000:0
RETAIL_DELIVERY_SLABS=
# Optional notifications; customer mobile is collected in delivery address.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
